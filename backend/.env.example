# iWear 后端配置。复制为 .env 后填写，.env 不得提交到 git，权限设为 600。
# 这里只保留变量名，不填任何值。

# 生图服务（试穿、新单品示意图）
IWEAR_IMAGE_BASE_URL=
IWEAR_IMAGE_API_KEY=
IWEAR_IMAGE_MODEL=

# 视觉识别（添加衣物）
IWEAR_VISION_BASE_URL=
IWEAR_VISION_API_KEY=
IWEAR_VISION_MODEL=

# 搭配师对话
IWEAR_STYLIST_BASE_URL=
IWEAR_STYLIST_API_KEY=
IWEAR_STYLIST_MODEL=

# 登录：development（验证码固定 123456）或 production
IWEAR_AUTH_MODE=
# 验证码 HMAC 密钥，至少 32 字节，生产模式必填
IWEAR_OTP_SECRET=

# 腾讯云短信，仅生产模式需要
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=

# 浏览器版跨域来源，逗号分隔，必须 HTTPS
IWEAR_CORS_ORIGINS=

# 每用户每日 AI 调用上限（留空使用默认值）
IWEAR_QUOTA_TRYON=
IWEAR_QUOTA_SUGGESTION=
IWEAR_QUOTA_STYLIST=
IWEAR_QUOTA_VISION=
